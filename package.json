{
  "name": "ditto-pay",
  "version": "0.0.0",
  "private": true,
  "description": "Ditto Pay monorepo: UK mobile payments platform (Expo app, Next.js web, Express + Supabase API).",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@ditto/web",
    "dev:api": "turbo run dev --filter=@ditto/api",
    "dev:mobile": "turbo run dev --filter=@ditto/mobile",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "knip": "knip",
    "check": "npm run lint && npm run typecheck && npm run knip && npm run test",
    "check:env": "node scripts/check-env.mjs",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "postinstall": "patch-package",
    "lock:regen": "rm -rf node_modules package-lock.json && npm install && rm -rf node_modules && npm ci",
    "figma": "node scripts/figma-tokens.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "knip": "6.35.1",
    "patch-package": "^8.0.0",
    "turbo": "2.10.13",
    "typescript": "5.9.3"
  }
}
