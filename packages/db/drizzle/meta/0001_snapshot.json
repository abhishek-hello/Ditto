      "policies": {
        "users read transactions touching their wallets": {
          "name": "users read transactions touching their wallets",
          "as": "PERMISSIVE",
          "for": "SELECT",
          "to": ["authenticated"],
          "using": "exists (\n        select 1 from public.wallets w\n        where w.owner_id = (select auth.uid())\n          and (w.id = \"transactions\".\"from_wallet_id\" or w.id = \"transactions\".\"to_wallet_id\")\n      )"
        }
      },
      "checkConstraints": {
        "transactions_kind_valid": {
          "name": "transactions_kind_valid",
          "value": "\"transactions\".\"kind\" in ('p2p', 'top_up', 'withdrawal', 'merchant')"
        },
        "transactions_status_valid": {
          "name": "transactions_status_valid",
          "value": "\"transactions\".\"status\" in ('pending', 'completed', 'failed', 'reversed')"
        },
        "transactions_currency_gbp": {
          "name": "transactions_currency_gbp",
          "value": "\"transactions\".\"currency\" = 'GBP'"
        },
        "transactions_amount_positive": {
          "name": "transactions_amount_positive",
          "value": "\"transactions\".\"amount_pence\" > 0"
        },
        "transactions_reference_length": {
          "name": "transactions_reference_length",
          "value": "char_length(\"transactions\".\"reference\") <= 35"
        },
        "transactions_has_a_wallet": {
          "name": "transactions_has_a_wallet",
          "value": "\"transactions\".\"from_wallet_id\" is not null or \"transactions\".\"to_wallet_id\" is not null"
        }
      },
