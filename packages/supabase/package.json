{
  "name": "@ditto/supabase",
  "version": "0.0.0",
  "private": true,
  "description": "Supabase client factories and generated Database types. Migrations live in ./supabase/migrations.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/database.types.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "types:generate": "supabase gen types typescript --local --schema public > src/database.types.ts",
    "db:start": "supabase start --workdir .",
    "db:stop": "supabase stop --workdir .",
    "db:reset": "supabase db reset --workdir .",
    "clean": "rm -rf .turbo"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0"
  },
  "devDependencies": {
    "@ditto/typescript-config": "*"
  }
}
