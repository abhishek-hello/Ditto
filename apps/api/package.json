{
  "name": "@ditto/api",
  "version": "0.0.0",
  "private": true,
  "description": "Ditto Pay backend: Node + Express 5, Supabase (service role), zod-validated routes.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@ditto/core": "*",
    "@ditto/db": "*",
    "@ditto/supabase": "*",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ditto/typescript-config": "*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "vitest": "^5.0.1"
  }
}
