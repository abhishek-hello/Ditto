# ─────────────────────────────────────────────────────────────────────────────
# Ditto Pay — environment variables catalogue
#
# Copy to `.env` at the repo root:   cp env.example .env
# Every app reads the ROOT .env (see ENVIRONMENTS.md). Never commit `.env`.
# `npm run check:env` compares this file against your .env and reports gaps.
#
# Prefix rules:
#   NEXT_PUBLIC_*  → inlined into the Next.js browser bundle (public)
#   EXPO_PUBLIC_*  → inlined into the Expo app bundle (public)
#   everything else → server-only (apps/api). Never expose to a client.
# ─────────────────────────────────────────────────────────────────────────────

# ── Shared ──────────────────────────────────────────────────────────────────
NODE_ENV=
LOG_LEVEL=

# ── Supabase (server-only) ──────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_DB_URL=

# ── API (apps/api) ──────────────────────────────────────────────────────────
PORT=
API_CORS_ORIGINS=

# ── Web (apps/web) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Mobile (apps/mobile) ────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
